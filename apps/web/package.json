{
  "name": "@vyrejack/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist node_modules/.vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:debug": "playwright test --debug",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@vyrejack/shared": "workspace:*",
    "gsap": "^3.14.2",
    "ox": "0.9.8",
    "preact": "^10.25.4",
    "rise-wallet": "0.2.29-1",
    "shreds": "^0.3.0",
    "viem": "2.37.8",
    "wouter-preact": "^3.9.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@preact/preset-vite": "^2.9.4",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.49",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass": "^1.97.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vite-plugin-mkcert": "^1.17.9",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "ox": "0.9.8",
    "viem": "2.37.8"
  }
}
